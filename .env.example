APP_NAME="La Embajada Paisa"
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://127.0.0.1:8000
APP_TIMEZONE=America/Bogota
APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_ES
LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=warning
DB_CONNECTION=sqlite
# MySQL: cambia DB_CONNECTION=mysql y agrega DB_HOST, DB_PORT, DB_DATABASE, DB_USERNAME y DB_PASSWORD.
SESSION_DRIVER=file
SESSION_LIFETIME=30
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=false
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
CACHE_STORE=file
QUEUE_CONNECTION=sync
MAIL_MAILER=log
BCRYPT_ROUNDS=12
# Solo para crear el primer administrador con php artisan db:seed (sin datos de demostración).
EMB_ADMIN_NAME="Administrador"
EMB_ADMIN_EMAIL=
EMB_ADMIN_PASSWORD=
